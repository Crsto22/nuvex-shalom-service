# =============================================================================
# shalom-service — variables de entorno para PRODUCCION
# Copiar a .env en el servidor y completar los valores marcados.
# NUNCA subir este archivo al repositorio.
# =============================================================================

# --- Aplicacion ---
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4100

# --- Base de datos (contenedor propio) ---
# POSTGRES_PASSWORD debe coincidir con la de DATABASE_URL.
POSTGRES_USER=nuvex_shalom
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=nuvex_shalom
POSTGRES_PUBLISHED_PORT=5433

# DATABASE_URL para scripts en el host (compose la sobreescribe dentro de los contenedores).
DATABASE_URL=postgresql://nuvex_shalom:CAMBIAR_PASSWORD_FUERTE@localhost:5433/nuvex_shalom?schema=public

# --- Seguridad (GENERAR NUEVOS) ---
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=GENERAR_BASE64_32_BYTES
# openssl rand -hex 32  (minimo 32 caracteres)
API_KEY_PEPPER=GENERAR_HEX_32
# openssl rand -hex 32
ADMIN_TOKEN=GENERAR_HEX_32

# HTTPS del subdominio; nunca dejar vacio en produccion
CORS_ORIGINS=https://shalom.TUDOMINIO.com
# 1 si esta detras de nginx/traefik
TRUST_PROXY_HOPS=1

# Limite de peticiones por aplicacion (por minuto, por replica)
RATE_LIMIT_PER_MINUTE=120
WEBHOOK_TIMEOUT_MS=10000

# --- Shalom ---
SHALOM_BASE_URL=https://pro.shalom.pe
SHALOM_TRACKING_URL=https://shalom.com.pe/rastrea/
SHALOM_HEADLESS=true
# En contratenedor Linux debe ser chromium
SHALOM_BROWSER_CHANNEL=chromium
SHALOM_MAX_CONTEXTS=2
SHALOM_ACQUIRE_TIMEOUT_MS=60000
SHALOM_LOGIN_TIMEOUT_MS=45000
SHALOM_RELOGIN_COOLDOWN_SECONDS=30

# Rastreo automatico desactivado (solo bajo demanda)
SHALOM_TRACKING_ENABLED=false
SHALOM_TRACKING_INTERVAL_MINUTES=15
SHALOM_TRACKING_BATCH=20

# --- Deploy ---
IMAGE_TAG=latest
API_PUBLISHED_PORT=4100
# WORKER_ID=worker-1   # opcional; por defecto hostname-pid

# NOTA: SHALOM_TENANT_ID, SHALOM_APPLICATION_ID y SHALOM_API_KEY NO se configuran a mano.
# Se obtienen al crear la empresa:
#   POST /v1/admin/tenants  (con X-Admin-Token)
# Las credenciales de Shalom (usuario/contrasena) se guardan cifradas en la base,
# nunca en este archivo.
