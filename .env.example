# --- Servicio ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4100

# --- Base de datos propia del servicio ---
DATABASE_URL=postgresql://nuvex_shalom:nuvex_shalom@localhost:5433/nuvex_shalom?schema=public

# --- Seguridad ---
# 32 bytes en base64: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Minimo 32 caracteres aleatorios. HMAC de las API keys.
API_KEY_PEPPER=
# Token temporal de administracion (crear API keys, webhooks). Quitar cuando exista portal.
ADMIN_TOKEN=
# Origenes permitidos (coma separada). Vacio = reflejar cualquier origen (solo desarrollo).
# Ejemplo: http://127.0.0.1:4173
CORS_ORIGINS=
# Limite de peticiones por aplicacion (por minuto, por replica)
RATE_LIMIT_PER_MINUTE=120

# --- Shalom ---
SHALOM_BASE_URL=https://pro.shalom.pe
SHALOM_TRACKING_URL=https://shalom.com.pe/rastrea/
SHALOM_HEADLESS=true
# chrome (Windows) | chromium (contenedor)
SHALOM_BROWSER_CHANNEL=chrome
# Maximo de contextos de navegador simultaneos en el worker
SHALOM_MAX_CONTEXTS=2
SHALOM_ACQUIRE_TIMEOUT_MS=60000
SHALOM_LOGIN_TIMEOUT_MS=45000

# --- Rastreo automatico (worker) ---
SHALOM_TRACKING_ENABLED=false
SHALOM_TRACKING_INTERVAL_MINUTES=15
SHALOM_TRACKING_BATCH=20

# --- Webhooks ---
WEBHOOK_TIMEOUT_MS=10000
SHALOM_RELOGIN_COOLDOWN_SECONDS=30
