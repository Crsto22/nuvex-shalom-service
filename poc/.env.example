# Credenciales de la cuenta Shalom PRO (empresa). NUNCA commitear el .env real.
SHALOM_EMAIL=arturo200512@gmail.com
SHALOM_PASSWORD=Cristhofer22*

# Navegador: "chrome" usa el Chrome instalado en Windows (recomendado, menos detectable).
# Cambiar a "chromium" solo si Chrome no esta disponible.
BROWSER_CHANNEL=chrome

# false = ventana visible (recomendado para la Fase 0.1).
HEADLESS=false

# true = no enviar el formulario, solo verificar que el login carga y los selectores existen.
CHECK_ONLY=false

# Milisegundos de espera tras el submit antes de evaluar el resultado.
LOGIN_TIMEOUT_MS=45000
